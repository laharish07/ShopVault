# MongoDB connection string (local example shown)
MONGO_URI=mongodb+srv://laharish07:LAHA2006@cluster0.rwqpou7.mongodb.net/shopvault2?retryWrites=true&w=majority

# Frontend origin(s) allowed to call the API. Separate several with commas.
# The first one is also used to build password reset links.
ORIGIN=http://localhost:3000

# Long random string used to sign session tokens, e.g. `openssl rand -hex 32`
SECRET_KEY=change-me

# Set to true in production: enables secure, cross-site cookies and real email delivery errors
PRODUCTION=false

# Port for local development
PORT=8000

# Gmail account used to send verification codes and reset links.
# Use an app password (https://myaccount.google.com/apppasswords), never your normal password.
# Leave blank in development: emails are printed to the server console instead.
EMAIL=
PASSWORD=

# Session length in days
COOKIE_EXPIRATION_DAYS=30

# Email verification code lifetime in milliseconds (default 10 minutes)
OTP_EXPIRATION_TIME=600000

# Password reset link lifetime in minutes
PASSWORD_RESET_EXPIRATION_MINUTES=30
